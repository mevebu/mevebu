{
  "name": "mevebu",
  "version": "2.3.0",
  "description": "Small tools that run in your browser. No accounts, no uploads, no tracking.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mevebu": "bin/mevebu.js"
  },
  "files": [
    "bin/",
    "mevebu/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "css": "tailwindcss -i mevebu/app/tailwind.src.css -o mevebu/app/tailwind.css",
    "css:watch": "tailwindcss -i mevebu/app/tailwind.src.css -o mevebu/app/tailwind.css --watch",
    "icons": "node scripts/vendor-icons.mjs",
    "dev": "node bin/mevebu.js",
    "start": "node bin/mevebu.js",
    "ship": "node scripts/ship.js",
    "social": "node scripts/vendor-social.mjs"
  },
  "keywords": [
    "tools",
    "offline",
    "privacy",
    "qr",
    "password",
    "uuid",
    "jwt",
    "cli",
    "no-tracking"
  ],
  "homepage": "https://github.com/mevebu/mevebu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mevebu/mevebu.git"
  },
  "bugs": {
    "url": "https://github.com/mevebu/mevebu/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "jsqr": "^1.4.0",
    "lucide": "^1.57.0",
    "mathjs": "^15.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode-generator": "^2.0.4",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.3.3"
  }
}
